{
  "description": "Project-level Keep Going Stop hook for Claude Code.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/keep-going-stop-hook.sh\"",
            "timeout": 360
          }
        ]
      }
    ]
  }
}
